+/// Lets WebRTC cancel the speakers' echo out of every call's microphone; on
+/// unless this says otherwise. With it off the microphone still gets the
+/// rumble filter. A call going on takes it at its next block.
+pub fn set_echo_cancel(on: bool) {
+    ECHO_CANCEL.store(on, Ordering::Relaxed);
+}
+
+#[cfg(feature = "discord")]
+pub(crate) fn echo_cancel() -> bool {
+    ECHO_CANCEL.load(Ordering::Relaxed)
+}
+
+/// Lets WebRTC control the gain of every call's microphone after the noise
+/// is out; on unless this says otherwise. A call going on takes it at its
+/// next block.
+pub fn set_auto_gain(on: bool) {
+    AUTO_GAIN.store(on, Ordering::Relaxed);
+}
+
+#[cfg(feature = "discord")]
+pub(crate) fn auto_gain() -> bool {
+    AUTO_GAIN.load(Ordering::Relaxed)
+}
+
 #[cfg(feature = "discord")]
 pub(crate) use denoise::{BLOCK, Denoiser, Sent};
 
